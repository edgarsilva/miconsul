package views

import (
	"miconsul/internal/models"
	"net/url"
	"strconv"
)

templ AppointmentStartPage(c *Ctx, appointment models.Appointment) {
	@DefaultLayout(c) {
		<div class="px-4 lg:px-8">
			@CmpBackBtn(c.l("btn.back"), "/appointments")
		</div>
		<section id="appointment_profile_cont" class="grow flex flex-col px-0 sm:px-4 md:px-8 py-8 lg:justify-center lg:w-2/3 lg:max-w-4xl lg:mx-auto">
			@AppointmentStartSection(c, appointment)
		</section>
	}
}

templ AppointmentPatientCard(c *Ctx, patient models.Patient) {
	<div>
		<hgroup
			class="flex justify-between items-center pb-4 pl-4 sm:pl-0"
			hx-boost:inherited="true"
		>
			<h1 class="font-bold text-2xl">{ c.l("str.patient") }</h1>
			<a
				href={ templ.URL("/appointments?timeframe=month&patientId=" + url.QueryEscape(patient.UID)) }
				class="btn btn-primary btn-sm"
			>
				@CmpCalendarIcon("w-5 h-5")
				{ c.l("btn.appointments") }
			</a>
		</hgroup>
		<section class="grid grid-cols-6 app-card ">
			<div class="col-span-full flex flex-col gap-10 sm:flex-row">
				<figure class="aspect-4/5 w-64 flex-none rounded-2xl overflow-hidden">
					@CmpLargeAvatar(patient)
				</figure>
				<div class="flex flex-col max-w-xl grow">
					<div class="pt-2 flex flex-wrap items-center gap-2">
						<a
							href={ templ.URL("/patients/" + patient.UID) }
							target="_blank"
							rel="noopener noreferrer"
							class="text-xl font-semibold tracking-tight mr-2 link link-hover"
						>{ patient.Name }</a>
						<span class="badge badge-ghost">{ c.l("str.age") + ": " + strconv.Itoa(patient.Age) }</span>
						<span class="badge badge-ghost">{ c.l("str.ocupation") + ": " + patient.Ocupation }</span>
					</div>
					<div class="mt-4 text-base leading-7 text-base-content/60">
						if len(patient.Appointments) > 0 {
							<h3 class="text-base-content text-sm font-semibold">Summary</h3>
							<blockquote class="mb-4">
								{ patient.Appointments[0].Summary }
							</blockquote>
							<h3 class="text-base-content text-sm font-semibold">Notes</h3>
							<blockquote class="mb-4">
								{ patient.Appointments[0].Notes }
							</blockquote>
						} else {
							<h3 class="text-base-content/30 text-md font-semibold">{ c.l("str.no_prev_apnt") }</h3>
						}
					</div>
					if len(patient.Appointments) > 0 {
						<div class="flex justify-end items-end grow" hx-boost:inherited="true">
							<a href="/appointments" class="link link-hover text-sm font-medium inline-flex items-center gap-1.5">
								<span>{ c.l("str.last_appointment") }</span>
								@CmpTime(patient.Appointments[0].BookedAt)
							</a>
						</div>
					}
				</div>
			</div>
		</section>
	</div>
}

templ AppointmentStartSection(c *Ctx, appointment models.Appointment) {
	<span class="absolute top-2 right-2 loading loading-ring text-primary loading-md htmx-indicator"></span>
	<div class="space-y-10 ">
		@AppointmentPatientCard(c, appointment.Patient)
		<div class="pt-8 gap-x-8 gap-y-8">
			<hgroup
				class="flex justify-between items-center pb-4 pl-4 sm:pl-0"
			>
				<h1 class="font-bold text-2xl">{ c.l("str.current_session") }</h1>
				@AppointmentSessionToggleBtn(c, appointment)
			</hgroup>
			<section class="relative bg-base-100 shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl">
				<input type="hidden" name="id" value={ appointment.UID } id="mb_appointment_id"/>
				<div class="flex items-start justify-between p-4 pb-0 text-base-content/50">
					@AppointmentSessionStatusBadge(c, appointment)
					@CmpTime(appointment.BookedAt)
				</div>
				<form
					id="save_appointment_session"
					method="POST"
					action={ templ.URL("/appointments/" + appointment.UID + "/save-session") }
					hx-post={ "/appointments/" + appointment.UID + "/save-session" }
				>
					<div class="px-4 py-6 sm:p-8">
						<div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
							<div class="col-span-full">
								<label for="website" class="block text-sm font-medium leading-6">{ c.l("str.observations") }</label>
								<div class="mt-2">
									<textarea
										name="observations"
										class="textarea w-full block"
										placeholder={ c.l("str.observations_ph") }
									>{ appointment.Observations }</textarea>
								</div>
							</div>
							<div class="col-span-full">
								<label for="website" class="block text-sm font-medium leading-6">{ c.l("str.conclusions") }</label>
								<div class="mt-2">
									<textarea
										name="conclusions"
										class="textarea w-full block"
										placeholder={ c.l("str.conclusions_ph") }
									>
										{ appointment.Conclusions }
									</textarea>
								</div>
							</div>
							<div class="col-span-full">
								<label for="about" class="block text-sm font-medium leading-6">{ c.l("str.summary") }</label>
								<div class="mt-2">
									<textarea
										name="summary"
										class="textarea w-full block"
										placeholder={ c.l("str.summary_ph") }
									>
										{ appointment.Summary }
									</textarea>
								</div>
							</div>
							<div class="col-span-full">
								<label for="website" class="block text-sm font-medium leading-6">{ c.l("str.notes") }</label>
								<div class="mt-2">
									<textarea
										name="notes"
										class="textarea w-full block"
										placeholder={ c.l("str.notes_ph") }
									>{ appointment.Notes }</textarea>
								</div>
							</div>
						</div>
					</div>
				</form>
				<div class="flex items-center justify-end gap-x-6 border-t border-base-content/10 px-4 py-4 sm:px-8">
					<button form="save_appointment_session" type="submit" class="btn btn-secondary">{ c.l("btn.save") }</button>
					<button
						form="save_appointment_session"
						type="button"
						hx-post={ "/appointments/" + appointment.UID + "/complete" }
						class="btn btn-primary"
					>{ c.l("btn.end_session") }</button>
				</div>
			</section>
		</div>
	</div>
}

templ AppointmentSessionStatusBadge(c *Ctx, appointment models.Appointment) {
	<div id="session_status_badge">
		if appointment.Status == models.AppointmentInProgress {
			@CmpStatusBadge(c, models.AppointmentInProgress)
		}
	</div>
}

// AppointmentSessionToggleBtn renders the start or pause session link.
templ AppointmentSessionToggleBtn(c *Ctx, appointment models.Appointment) {
	<div id="session_toggle">
		if appointment.Status == models.AppointmentInProgress {
			<a
				class="btn btn-secondary btn-sm"
				href={ templ.URL("/appointments/" + appointment.UID + "/pause-session") }
				hx-post={ "/appointments/" + appointment.UID + "/pause-session" }
				hx-target="#session_toggle"
				hx-swap="outerHTML"
			>
				{ c.l("btn.pause_session") }
			</a>
		} else {
			<a
				class="btn btn-primary btn-sm"
				href={ templ.URL("/appointments/" + appointment.UID + "/start-session") }
				hx-post={ "/appointments/" + appointment.UID + "/start-session" }
				hx-target="#session_toggle"
				hx-swap="outerHTML"
			>
				{ c.l("btn.start_session") }
			</a>
		}
	</div>
}

// AppointmentSessionToggle renders AppointmentSessionToggleBtn and swaps the
// session status badge (#session_status_badge) out of band.
templ AppointmentSessionToggle(c *Ctx, appointment models.Appointment) {
	@AppointmentSessionToggleBtn(c, appointment)
	<div id="session_status_badge" hx-swap-oob="outerHTML">
		if appointment.Status == models.AppointmentInProgress {
			@CmpStatusBadge(c, models.AppointmentInProgress)
		}
	</div>
}
