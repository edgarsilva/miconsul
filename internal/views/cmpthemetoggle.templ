package views

import "miconsul/internal/lib/preferences"

// CmpThemeBtn renders the swap theme toggle; a click only saves the
// choice. With a saved theme the page is light (data-theme on <html>) and the
// checked box applies dark. With none the page follows the OS, so one of two
// toggles shows, matching the OS, and a click always flips what is on screen;
// that first save reloads the page once so <html> gets its data-theme.
templ CmpThemeBtn(theme string) {
	switch theme {
		case preferences.ThemeLight, preferences.ThemeDark:
			@themeSwap(preferences.ThemeDark, preferences.ThemeLight, theme == preferences.ThemeDark, false)
		default:
			@themeSwap(preferences.ThemeDark, preferences.ThemeLight, false, true, "dark:hidden")
			@themeSwap(preferences.ThemeLight, preferences.ThemeDark, false, true, "hidden", "dark:inline-grid")
	}
}

// themeSwap is one swap toggle: checked it applies checkedTheme, unchecked the
// page shows uncheckedTheme. It posts both, so the handler saves the one on
// screen. fromOS marks the toggles shown while the page follows the OS.
templ themeSwap(checkedTheme, uncheckedTheme string, checked, fromOS bool, classes ...string) {
	<label
		class={ "swap swap-rotate", classes }
		hx-post="/theme/toggle"
		hx-trigger="change"
		hx-swap="none"
		hx-include="this"
		hx-vals={ templ.JSONString(themeSwapVals(checkedTheme, uncheckedTheme, fromOS)) }
	>
		<input
			name="theme"
			type="checkbox"
			class="theme-controller"
			value={ preferences.ThemeName(checkedTheme) }
			if checked {
				checked="true"
			}
		/>
		if checkedTheme == preferences.ThemeDark {
			@CmpSunIcon("swap-off size-8")
			@CmpMoonIcon("swap-on size-8")
		} else {
			@CmpMoonIcon("swap-off size-8")
			@CmpSunIcon("swap-on size-8")
		}
	</label>
}

func themeSwapVals(checkedTheme, uncheckedTheme string, fromOS bool) map[string]string {
	vals := map[string]string{"checked": checkedTheme, "unchecked": uncheckedTheme}
	if fromOS {
		vals["from"] = "os"
	}

	return vals
}
