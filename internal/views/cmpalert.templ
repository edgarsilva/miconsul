package views

// CmpFlashAlert renders the alert a redirect carried in its flash message, if
// there is one.
templ CmpFlashAlert(c *Ctx) {
	if c.Alert.Msg != "" {
		<div role="alert" class={ "alert", alertLevelClass(c.Alert.Level) }>
			switch c.Alert.Level {
				case LevelSuccess:
					@CmpCheckCircleIcon("shrink-0 h-6 w-6")
				case LevelWarning:
					@CmpWarningIcon("shrink-0 h-6 w-6")
				case LevelError:
					@CmpCloseCircleIcon("shrink-0 h-6 w-6")
				default:
					@CmpInfoIcon("shrink-0 h-6 w-6")
			}
			<span>{ c.Alert.Msg }</span>
		</div>
	}
}

// alertLevelClass maps a level to its daisyUI alert color.
func alertLevelClass(level Level) string {
	switch level {
	case LevelSuccess:
		return "alert-success"
	case LevelWarning:
		return "alert-warning"
	case LevelError:
		return "alert-error"
	default:
		return "alert-info"
	}
}
