package views

templ CmpPasswordInput(value string) {
	<label class="input w-full flex items-center gap-2">
		@CmpKeyIcon("w-5 h-5")
		<input name="password" type="password" placeholder="Password" value={ value } autocomplete="new-password"/>
		<span class="cursor-pointer swap swap-flip" hx-on:click="const input = this.parentElement.querySelector('input'); input.type = input.type === 'password' ? 'text' : 'password'; this.classList.toggle('swap-active')">
			@CmpEyeIcon("w-6 h-6 swap-on")
			@CmpEyeOffIcon("w-6 h-6 swap-off")
		</span>
	</label>
}

templ CmpConfirmPasswordInput(value string) {
	<label class="input w-full flex items-center gap-2">
		@CmpShieldCheckIcon("w-5 h-5")
		<input name="confirm" type="password" placeholder="Password" value={ value } autocomplete="new-password"/>
		<span class="cursor-pointer swap swap-flip" hx-on:click="const input = this.parentElement.querySelector('input'); input.type = input.type === 'password' ? 'text' : 'password'; this.classList.toggle('swap-active')">
			@CmpEyeIcon("w-6 h-6 swap-on")
			@CmpEyeOffIcon("w-6 h-6 swap-off")
		</span>
	</label>
}
