package views

templ AuthResetPasswordPage(c *Ctx, email, success string, err error) {
	@AuthLayout(c) {
		<div class="absolute top-4 right-4">
			@CmpThemeBtn(c.Theme)
		</div>
		<div class="pt-10 card glass bg-base-100 shadow-xl w-full sm:max-w-[480px] sm:mx-auto">
			<div class="flex justify-center">
				<div
					class="w-28 rounded-lg overflow-clip"
				>
					@CmpLogo()
				</div>
			</div>
			<div class="card-body">
				<h2 class="card-title">
					Miconsul
					<div class="badge badge-secondary">INC</div>
					<div class="text-sm leading-6 ml-auto">
						<a href="/signin" class="link link-secondary link-hover font-semibold underline-offset-2">{ c.l("str.login_instead") }</a>
					</div>
				</h2>
				<form class="space-y-6" action="/resetpassword" method="POST">
					@CmpEmailInput(email)
					@CmpFlashAlert(c)
					if success != "" {
						<div role="alert" class="alert alert-success">
							@CmpCheckCircleIcon("shrink-0 h-6 w-6")
							<span>{ success }</span>
						</div>
					}
					if err != nil {
						<div role="alert" class="alert">
							@CmpWarningIcon("shrink-0 h-6 w-6")
							<span class="first-letter:uppercase">{ err.Error() }</span>
						</div>
					}
					<div>
						<button type="submit" class="btn btn-primary btn-block">{ c.l("str.reset_my_password") }</button>
					</div>
				</form>
			</div>
		</div>
		<div>
			<p class="mt-10 text-center text-sm">
				{ c.l("str.not_a_member") }
				<a href="/signup" class="ml-1 link link-info link-hover font-semibold leading-6">{ c.l("str.create_account") }</a>
			</p>
		</div>
	}
}
