package views

templ AuthChangePasswordPage(c *Ctx, email, token string, err error) {
	@AuthLayout(c) {
		<div class="absolute top-4 right-4">
			@CmpThemeBtn(c.Theme)
		</div>
		<div class="pt-10 card glass bg-base-100 shadow-lg w-full sm:max-w-[480px] sm:mx-auto">
			<div class="flex justify-center">
				<div
					class="w-28 rounded-lg overflow-clip shadow-xl"
				>
					@CmpLogo()
				</div>
			</div>
			<div class="card-body">
				<h2 class="card-title">
					Change your password
					<div class="badge badge-secondary">INC</div>
				</h2>
				<form class="space-y-6" action="/resetpassword/change" method="POST">
					<input type="hidden" name="token" value={ token }/>
					<input type="hidden" name="email" value={ email }/>
					<label class="input input-disabled flex items-center gap-2">
						@CmpEmailIcon()
						<span>{ email }</span>
					</label>
					@CmpPasswordInput("")
					@CmpConfirmPasswordInput("")
					if err != nil {
						<div role="alert" class="alert alert-warning">
							@CmpWarningIcon("shrink-0 h-6 w-6")
							<span class="first-letter:uppercase">{ err.Error() }</span>
						</div>
					}
					<div>
						<button type="submit" class="btn btn-primary btn-block">Change password</button>
					</div>
				</form>
			</div>
		</div>
		<div>
			<p class="mt-10 text-center text-sm">
				Not a member?
				<a href="/signup" class="ml-1 link link-info link-hover font-semibold leading-6">Sign up</a>
			</p>
		</div>
	}
}
