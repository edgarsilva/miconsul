package views

// chartWrapperClasses style the ApexCharts tooltip box with the theme:
// the one card around the chart-tooltip content.
const chartWrapperClasses = "[&_.apexcharts-tooltip]:bg-base-100! [&_.apexcharts-tooltip]:border-base-content/10! [&_.apexcharts-tooltip]:shadow-2xl! [&_.apexcharts-tooltip]:rounded-box! [&_.apexcharts-svg]:outline-none"

// CmpChartTooltip is the tooltip the charts clone: public/js/charts.js
// fills the dot class, label and value. It sits outside the charts, whose
// contents ApexCharts redraws.
templ CmpChartTooltip() {
	<template id="chart-tooltip">
		<div class="text-base-content p-3 text-xs">
			<div class="flex items-center gap-2">
				<span class="size-2 rounded-selector" data-tooltip-dot></span>
				<span class="text-base-content/70"><span data-tooltip-label></span>: <b class="text-base-content ml-1" data-tooltip-value></b></span>
			</div>
		</div>
	</template>
}
