package views

import (
	"miconsul/internal/lib/profilepic"
	"miconsul/internal/models"
	"strconv"
)

templ ClinicIndexPage(c *Ctx, clinics []models.Clinic) {
	@DefaultLayout(c) {
		<section class="grow flex flex-col px-0 sm:px-4 pt-4 md:pt-6 md:pb-16 lg:w-2/3 lg:max-w-4xl lg:mx-auto">
			<div
				class="relative"
			>
				<hgroup class="md:flex md:justify-between md:items-center pb-4 px-2 md:px-0 w-full" hx-boost:inherited="true">
					<div class="md:flex md:gap-2 items-baseline w-full md:justify-between md:pr-4">
						<h1 class="flex w-full md:w-auto font-bold text-2xl mb-4 md:mb-0">
							{ c.l("str.clinics") }
							<a
								href="/clinics/new"
								class="ml-auto btn btn-primary btn-sm md:hidden"
							>
								@CmpBuildingIcon("size-5")
								{ c.l("btn.new") }
							</a>
						</h1>
						@CmpSearchInput(c, c.l("str.search_clinics"), "/clinics/search", "#clinics_list")
					</div>
					<a
						href="/clinics/new"
						class="hidden md:flex btn btn-primary btn-sm"
					>
						@CmpBuildingIcon("size-5")
						{ c.l("btn.new") }
					</a>
				</hgroup>
				if (len(clinics) > 0) {
					@ClinicList(c, clinics)
				} else {
					@ClinicEmptyList(c)
				}
			</div>
		</section>
	}
}

templ ClinicFormPage(c *Ctx, clinic models.Clinic) {
	@DefaultLayout(c) {
		<div class="px-4 lg:px-8">
			@CmpBackBtn(c.l("btn.back"), "/clinics")
		</div>
		@ClinicProfileSection(c, clinic)
	}
}

templ ClinicList(c *Ctx, clinics []models.Clinic) {
	<ul id="clinics_list" role="list" class="app-card divide-y divide-base-content/10 overflow-hidden2">
		for _, clinic := range clinics {
			@ClinicLi(c, clinic)
		}
	</ul>
}

templ ClinicLi(c *Ctx, clinic models.Clinic) {
	<li class="relative flex justify-between items-center gap-x-6 px-2 py-2 hover:bg-base-200/75">
		<div class="flex items-center min-w-0 gap-x-4">
			if clinic.ProfilePic != "" {
				<div class="avatar">
					<div class="w-12 rounded-full">
						<img src={ string(templ.URL(clinic.ProfilePic)) }/>
					</div>
				</div>
			} else {
				<div class="avatar placeholder">
					<div class="bg-neutral text-neutral-content rounded-full w-12">
						<span class="text-xl">{ clinic.Initials() }</span>
					</div>
				</div>
			}
			<div class="min-w-0">
				<p class="font-semibold text-base-content flex items-center" hx-boost:inherited="true">
					<a href={ templ.URL("/clinics/" + clinic.UID) }>
						{ clinic.Name }
					</a>
					if clinic.Favorite {
						<span class="text-yellow-500 ml-2">
							@CmpStarIcon("w-5 h-5")
						</span>
					}
				</p>
				<p class="flex text-xs text-base-content/60">
					<a
						href={ templ.URL("mailto:" + clinic.Email) }
						class="relative truncate hover:underline"
					>
						{ clinic.Email }
					</a>
				</p>
			</div>
		</div>
		<div class="hidden md:flex gap-1">
			<a
				href={ templ.URL("/appointments?clinicId=" + clinic.UID) }
				class="btn btn-sm"
				hx-boost="true"
			>
				@CmpCalendarIcon("size-4")
				{ c.l("btn.appointments") }
			</a>
			<a
				href={ templ.URL("/clinics/" + clinic.UID) }
				class="btn btn-sm"
				hx-boost="true"
			>
				@CmpPencilIcon("size-4")
				{ c.l("btn.edit") }
			</a>
		</div>
	</li>
}

templ ClinicDeleteForm(c *Ctx, clinic models.Clinic) {
	<form
		class="ml-auto"
		method="POST"
		action={ templ.URL("/clinics/" + clinic.UID) }
		hx-delete={ "/clinics/" + clinic.UID }
		hx-confirm={ c.l("str.are_you_sure") }
		hx-target="this"
		hx-swap="none"
	>
		<button type="submit" class="btn btn-sm btn-secondary ml-auto">
			@CmpTrashIcon("w-5 h-5")
			Delete
		</button>
	</form>
}

templ ClinicEmptyList(c *Ctx) {
	<div class="app-card flex">
		<a href="/clinics/new" class="relative block w-full rounded-lg border-2 border-dashed border-base-content/30 p-12 text-center hover:border-base-content/40 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
			@CmpUserAddIcon("mx-auto w-12 h-12 text-base-content/60")
			<span class="mt-2 block text-sm font-semibold">{ c.l("str.new_clinic") }</span>
		</a>
	</div>
}

templ ClinicProfile(c *Ctx, clinic models.Clinic) {
	<div id="clinic_profile" class="space-y-10 divide-y divide-base-content/10">
		<div class="grid grid-cols-1 gap-x-8 gap-y-8 pt-10 md:grid-cols-3">
			<div class="px-4 sm:px-0">
				<h2 class="text-base font-semibold leading-7">{ c.l("str.clinic_info") }</h2>
				<p class="mt-1 text-sm leading-6 text-base-content/60">{ c.l("str.clinic_info_desc") }</p>
			</div>
			@ClinicForm(c, clinic) {
				<input type="hidden" name="id" value={ clinic.UID } id="pi_clinic_id"/>
				<div class="px-4 py-6 sm:p-8">
					<div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
						<div class="col-span-full">
							<label for="profile_pic" class="block text-sm font-medium leading-6">{ c.l("str.profile_pic") }</label>
							<div class="mt-2 flex items-center gap-x-3">
								if clinic.ProfilePic != "" {
									<div class="avatar">
										<div class="w-12 rounded-full">
											<img src={ string(templ.URL(clinic.ProfilePic)) }/>
										</div>
									</div>
								} else {
									<div class="avatar placeholder">
										<div class="bg-neutral text-neutral-content rounded-full w-12">
											<span class="text-xl">{ clinic.Initials() }</span>
										</div>
									</div>
								}
								<input
									id="profile_pic"
									name="profilePic"
									type="file"
									class="file-input w-full file-input-primary"
									accept={ profilepic.Accept }
									if len(clinic.FieldErrors()) > 0 {
										hx-preserve
									}
								/>
							</div>
						</div>
						<div class="sm:col-span-4">
							<label for="name" class="block text-sm font-medium leading-6">{ c.l("str.clinic_name") }</label>
							<div class="mt-2">
								<input required min="2" type="text" name="name" value={ clinic.Name } id="name" autocomplete="organization" class="input block w-full"/>
								if clinic.FieldError("name") != "" {
									<div class="label">
										<span class="text-error">{ clinic.FieldError("name") }</span>
									</div>
								}
							</div>
						</div>
						<div class="sm:col-span-4">
							<label for="email" class="block text-sm font-medium leading-6 text-base-content">{ c.l("str.email_address") }</label>
							<div class="mt-2">
								<input required type="email" name="email" value={ clinic.Email } id="email" autocomplete="email" class="input block w-full"/>
							</div>
						</div>
						<div class="sm:col-span-2 flex flex-col">
							<label for="favorite" class="block text-sm font-medium leading-6 text-base-content">{ c.l("str.favorite") }</label>
							<div class="flex items-center grow">
								<input type="checkbox" name="favorite" value={ strconv.FormatBool(clinic.Favorite) } id="favorite" class="toggle toggle-warning"/>
							</div>
						</div>
						<div class="sm:col-span-4">
							<label for="phone" class="block text-sm font-medium leading-6 text-base-content">{ c.l("str.phone") }</label>
							<div class="mt-2">
								<input required type="text" name="phone" value={ clinic.Phone } id="phone" autocomplete="phone" class="input block w-full"/>
							</div>
						</div>
						<div class="sm:col-span-3">
							<label for="price" class="block text-sm font-medium leading-6 text-base-content">{ c.l("str.appt_price") }</label>
							<div class="mt-2">
								<input
									required
									type="number"
									id="price"
									name="price"
									min="1"
									max="100000"
									step="0.01"
									if clinic.Price == 0 {
										value="0.00"
									} else {
										value={ clinic.PriceInputValue() }
									}
									class="input block w-full"
								/>
							</div>
						</div>
						<div class="col-span-full">
							<label for="cover_photo" class="block text-sm font-medium leading-6">{ c.l("str.cover_photo") }</label>
							<div class="mt-2 flex justify-center rounded-lg border border-dashed border-base-content/25 px-6 py-10">
								<div class="text-center">
									@CmpImageIcon("mx-auto h-12 w-12 text-base-content/60")
									<div class="mt-4 flex text-sm leading-6 text-base-content/60">
										<label for="cover_photo" class="relative link link-primary font-semibold leading-6">
											<span>{ c.l("str.upload_file") }</span>
											<input id="cover_photo" name="coverPhoto" type="file" class="sr-only" accept="image/*"/>
										</label>
										<p class="pl-1">{ c.l("str.or_drag_and_drop") }</p>
									</div>
									<p class="text-xs leading-5 text-base-content/60">PNG, JPG, GIF { c.l("str.up_to_10mb") }</p>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="flex items-center justify-end gap-x-6 border-t border-base-content/10 px-4 py-4 sm:px-8">
					<button type="button" class="btn btn-ghost">{ c.l("btn.cancel") }</button>
					<button type="submit" class="btn btn-primary">{ c.l("btn.save") }</button>
				</div>
			}
		</div>
		<div class="grid grid-cols-1 gap-x-8 gap-y-8 pt-10 md:grid-cols-3">
			<div class="px-4 sm:px-0">
				<h2 class="text-base font-semibold leading-7">{ c.l("str.address") }</h2>
				<p class="mt-1 text-sm leading-6 text-base-content/60">{ c.l("str.address_desc") }</p>
			</div>
			@ClinicForm(c, clinic) {
				<input type="hidden" name="id" value={ clinic.UID } id="address_clinic_id"/>
				<div class="px-4 py-6 sm:p-8">
					<div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
						<div class="col-span-full">
							<label for="address_line1" class="block text-sm font-medium leading-6">{ c.l("str.address_street") }</label>
							<div class="mt-2">
								<input type="text" name="addressLine1" value={ clinic.Address.Line1 } id="address_line1" autocomplete="street-address" class="input block w-full"/>
							</div>
						</div>
						<div class="sm:col-span-2 sm:col-start-1">
							<label for="address_city" class="block text-sm font-medium leading-6">{ c.l("str.address_city") }</label>
							<div class="mt-2">
								<input type="text" name="addressCity" value={ clinic.Address.City } id="address_city" autocomplete="address-level2" class="input block w-full"/>
							</div>
						</div>
						<div class="sm:col-span-2">
							<label for="address_state" class="block text-sm font-medium leading-6">{ c.l("str.address_state") }</label>
							<div class="mt-2">
								<input type="text" name="addressState" value={ clinic.Address.State } id="address_state" autocomplete="address-level1" class="input block w-full"/>
							</div>
						</div>
						<div class="sm:col-span-2">
							<label for="address_zip_code" class="block text-sm font-medium leading-6">{ c.l("str.address_zip_code") }</label>
							<div class="mt-2">
								<input type="text" name="addressZipCode" value={ clinic.Address.Zip } id="address_zip_code" autocomplete="postal-code" class="input block w-full"/>
							</div>
						</div>
					</div>
					<div class="sm:col-span-4">
						<label for="address_country" class="block text-sm font-medium leading-6 text-base-content">{ c.l("str.address_country") }</label>
						<div class="mt-2">
							<select id="address_country" name="addressCountry" autocomplete="country-name" class="select block w-full">
								@patientCountryOption("none", "none", clinic.Country)
								@patientCountryOption("Mexico", "Mexico", clinic.Country)
								@patientCountryOption("United States", "United States", clinic.Country)
								@patientCountryOption("Canada", "Canada", clinic.Country)
							</select>
						</div>
					</div>
				</div>
				<div class="flex items-center justify-end gap-x-6 border-t border-base-content/10 px-4 py-4 sm:px-8">
					<button type="button" class="btn btn-ghost">{ c.l("btn.cancel") }</button>
					<button type="submit" class="btn btn-primary">{ c.l("btn.save") }</button>
				</div>
			}
		</div>
		<div class="grid grid-cols-1 pt-8 gap-x-8 gap-y-8 md:grid-cols-3">
			<div class="px-4 sm:px-0">
				<h2 class="text-base font-semibold leading-7">{ c.l("str.social_media") }</h2>
				<p class="mt-1 text-sm leading-6 text-base-content/60">{ c.l("str.social_media_desc") }</p>
			</div>
			@ClinicForm(c, clinic) {
				<input type="hidden" name="id" value={ clinic.UID } id="mb_clinic_id"/>
				<div class="px-4 py-6 sm:p-8">
					<div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
						<div class="sm:col-span-4">
							<label for="email" class="block text-sm font-medium leading-6 text-base-content">{ c.l("str.facebook") }</label>
							<div class="mt-2">
								<input type="url" name="facebook" value={ clinic.Facebook } id="facebook" autocomplete="url" class="input block w-full"/>
							</div>
						</div>
						<div class="sm:col-span-4">
							<label for="email" class="block text-sm font-medium leading-6 text-base-content">{ c.l("str.instagram") }</label>
							<div class="mt-2">
								<input type="url" name="instagram" value={ clinic.Instagram } id="instagram" autocomplete="url" class="input block w-full"/>
							</div>
						</div>
						<div class="sm:col-span-4">
							<label for="email" class="block text-sm font-medium leading-6 text-base-content">{ c.l("str.whatsapp") }</label>
							<div class="mt-2">
								<input type="tel" name="whatsapp" value={ clinic.Whatsapp } id="whatsapp" autocomplete="phone" class="input block w-full"/>
							</div>
						</div>
						<div class="sm:col-span-4">
							<label for="email" class="block text-sm font-medium leading-6 text-base-content">{ c.l("str.telegram") }</label>
							<div class="mt-2">
								<input type="tel" name="telegram" value={ clinic.Telegram } id="telegram" autocomplete="phone" class="input block w-full"/>
							</div>
						</div>
					</div>
				</div>
				<div class="flex items-center justify-end gap-x-6 border-t border-base-content/10 px-4 py-4 sm:px-8">
					<button type="button" class="btn btn-ghost">{ c.l("btn.cancel") }</button>
					<button type="submit" class="btn btn-primary">{ c.l("btn.save") }</button>
				</div>
			}
		</div>
	</div>
}

templ ClinicForm(c *Ctx, clinic models.Clinic) {
	<form
		class="relative bg-base-100 shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl md:col-span-2"
		method="POST"
		enctype="multipart/form-data"
		if clinic.UID == "" {
			hx-post="/clinics"
			action="/clinics"
		} else {
			hx-patch={ "/clinics/" + clinic.UID }
			action={ templ.URL("/clinics/" + clinic.UID) }
		}
		hx-target="closest #clinic_profile_cont"
		hx-swap="outerHTML settle:0"
	>
		<span class="absolute top-2 right-2 loading loading-ring loading-sm htmx-indicator"></span>
		{ children... }
	</form>
}

// ClinicProfileSection renders the clinic page's form section.
templ ClinicProfileSection(c *Ctx, clinic models.Clinic) {
	<section id="clinic_profile_cont" class="grow flex flex-col px-0 sm:px-4 md:px-8 py-8 lg:justify-center lg:w-2/3 lg:max-w-4xl lg:mx-auto">
		if clinic.UID == "" {
			<h1 class="px-4 sm:px-0 font-bold text-2xl pb-0 w-full">{ c.l("str.new_clinic") }</h1>
		} else {
			<h1 class="px-4 sm:px-0 font-bold text-2xl pb-0 w-full inline-flex">
				{ c.l("str.edit_clinic") }
				@ClinicDeleteForm(c, clinic)
			</h1>
		}
		@ClinicProfile(c, clinic)
	</section>
}
