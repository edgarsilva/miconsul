package views

templ GlobalToastRegion(c *Ctx) {
	<div
		aria-live="assertive"
		class="pointer-events-none fixed inset-0 flex items-end px-4 py-6 sm:items-start sm:p-6"
	>
		<div id="toast_region" class="flex w-full flex-col items-center space-y-4 sm:items-end pt-12">
			if c.Toast.Msg != "" {
				@CmpToast(c.Toast.Msg, c.Toast.Sub, c.Toast.Level)
			}
		</div>
	</div>
}

func LevelClasses(level string) string {
	switch level {
	case "success":
		return "text-success-content bg-success"
	case "warning":
		return "text-warning-content bg-warning"
	case "error":
		return "text-error-content bg-error"
	default:
		return "text-info-content bg-info"
	}
}

// CmpToast renders a notification that slides in, fades out after 3s (the
// toast CSS animation) and hides when its close checkbox is checked.
templ CmpToast(msg, sub, level string) {
	<div class="toast-card pointer-events-auto w-full max-w-sm overflow-hidden rounded-lg bg-base-100 shadow-lg ring-1 ring-black ring-opacity-35 has-checked:hidden">
		<div class={ "p-4 ", LevelClasses(level) }>
			<div class="flex items-start">
				<div class="shrink-0">
					switch level {
						case "success":
							<svg class="h-6 w-6 text-success-content" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
						case "warning":
							<svg class="h-6 w-6 text-warning-content" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"></path>
							</svg>
						case "error":
							<svg class="h-6 w-6 text-error-content" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
							</svg>
						default:
							<svg class="h-6 w-6 text-info-content" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"></path>
							</svg>
					}
				</div>
				<div class="ml-3 w-0 flex-1 pt-0.5">
					<p class="text-sm font-medium">{ msg }</p>
					<p class="mt-1 text-sm">
						{ sub }
					</p>
				</div>
				<div class="ml-4 flex shrink-0">
					<label class="p-0 cursor-pointer">
						<input type="checkbox" class="sr-only"/>
						<span class="sr-only">Close</span>
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
						</svg>
					</label>
				</div>
			</div>
		</div>
	</div>
}

// CmpToastPartial shows a toast from an HTMX response without replacing the
// request's target: HTMX 4 appends it to the toast region and skips the main
// swap.
templ CmpToastPartial(msg, sub, level string) {
	<hx-partial hx-target="#toast_region" hx-swap="beforeend">
		@CmpToast(msg, sub, level)
	</hx-partial>
}
