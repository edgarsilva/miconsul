package views

import (
	"fmt"

	"miconsul/internal/models"
)

// CmpToastRegion renders the page's toast region with the request's toast.
templ CmpToastRegion(c *Ctx) {
	<div
		aria-live="assertive"
		class="pointer-events-none fixed inset-0 flex items-end px-4 py-6 sm:items-start sm:p-6"
	>
		<div id="toast_region" class="flex w-full flex-col items-center space-y-4 sm:items-end pt-12">
			if c.Toast.Msg != "" {
				@CmpToast(c.Toast.Msg, c.Toast.Sub, c.Toast.Level)
			}
		</div>
	</div>
}

func toastLevelClass(level Level) string {
	switch level {
	case LevelSuccess:
		return "text-success-content bg-success"
	case LevelWarning:
		return "text-warning-content bg-warning"
	case LevelError:
		return "text-error-content bg-error"
	default:
		return "text-info-content bg-info"
	}
}

// CmpToast renders a notification that slides in, fades out after 3s (the
// toast CSS animation) and hides when its close checkbox is checked.
templ CmpToast(msg, sub string, level Level) {
	<div class="toast-card pointer-events-auto w-full max-w-sm overflow-hidden rounded-lg bg-base-100 shadow-lg ring-1 ring-black ring-opacity-35 has-checked:hidden">
		<div class={ "p-4 ", toastLevelClass(level) }>
			<div class="flex items-start">
				<div class="shrink-0">
					switch level {
						case LevelSuccess:
							@CmpCheckCircleIcon("h-6 w-6 text-success-content")
						case LevelWarning:
							@CmpWarningIcon("h-6 w-6 text-warning-content")
						case LevelError:
							@CmpCloseCircleIcon("h-6 w-6 text-error-content")
						default:
							@CmpInfoIcon("h-6 w-6 text-info-content")
					}
				</div>
				<div class="ml-3 w-0 flex-1 pt-0.5">
					<p class="text-sm font-medium">{ msg }</p>
					<p class="mt-1 text-sm">
						{ sub }
					</p>
				</div>
				<div class="ml-4 flex shrink-0">
					<label class="p-0 cursor-pointer">
						<input type="checkbox" class="sr-only"/>
						<span class="sr-only">Close</span>
						@CmpCloseIcon("w-6 h-6")
					</label>
				</div>
			</div>
		</div>
	</div>
}

// CmpToastPartial shows a toast from an HTMX response without replacing the
// request's target: HTMX 4 appends it to the toast region and skips the main
// swap.
templ CmpToastPartial(msg, sub string, level Level) {
	<hx-partial hx-target="#toast_region" hx-swap="beforeend">
		@CmpToast(msg, sub, level)
	</hx-partial>
}

// SearchFailedMsg tells the user a search couldn't run.
const SearchFailedMsg = "The search couldn't be completed right now, please try again"

// SearchTooShortMsg tells the user a search term needs at least
// models.MinSearchTermLen characters.
func SearchTooShortMsg() string {
	return fmt.Sprintf("Type at least %d characters to search", models.MinSearchTermLen)
}

// CmpSearchTooShortToast shows SearchTooShortMsg as a toast partial.
templ CmpSearchTooShortToast() {
	@CmpToastPartial(SearchTooShortMsg(), "", LevelWarning)
}

// CmpSearchFailedToast shows SearchFailedMsg as a toast partial.
templ CmpSearchFailedToast() {
	@CmpToastPartial(SearchFailedMsg, "", LevelError)
}
