package views

import (
	"fmt"
	"math"
	"miconsul/internal/lib/amount"
	"miconsul/internal/lib/libtime"
	"miconsul/internal/lib/number"
	"miconsul/internal/models"
	"time"
)

type DashboardStat struct {
	Total int
	Diff  int
}

type DashboardStats struct {
	Patients     DashboardStat
	Appointments DashboardStat
	Revenue      DashboardRevenue
}

// DashboardRevenue is the price of done appointments booked this month so far,
// and over the same days last month, in cents.
type DashboardRevenue struct {
	Total    int
	Previous int
}

// Change returns the percent change from last month; ok is false when last
// month had no revenue or the change rounds to 0.0%.
func (r DashboardRevenue) Change() (pct float64, ok bool) {
	if r.Previous == 0 {
		return 0, false
	}

	pct = float64(r.Total-r.Previous) / float64(r.Previous) * 100
	if math.Abs(pct) < 0.05 {
		return 0, false
	}

	return pct, true
}

templ DashboardPage(c *Ctx, stats DashboardStats, appointments []models.Appointment, favClinic models.Clinic, feedEvents []models.FeedEvent) {
	@DefaultLayout(c) {
		<div id="content" class="container md:mx-auto md:px-4">
			@DashboardMonthTrends(c, stats)
			<div class="flex-1 grid grid-cols-3 gap-5 mt-8">
				<section
					class="col-span-3 lg:col-span-2 order-1 lg:order-1"
				>
					@DashboardAppointmentsSection(c, appointments)
				</section>
				<section
					class="col-span-3 lg:col-span-1 order-2 lg:order-2 flex flex-col gap-8"
				>
					@DashboardFavoriteClinic(c, favClinic)
					@DashboardFeed(c, feedEvents)
				</section>
			</div>
		</div>
	}
}

// DashboardAppointmentsSection renders the dashboard's filterable appointments
// list.
templ DashboardAppointmentsSection(c *Ctx, appointments []models.Appointment) {
	@AppointmentListSection(c, AppointmentListSectionProps{
		Appointments: appointments,
		ShowTitle:    true,
		PagePath:     "/dashboard",
		SectionPath:  "/dashboard/appointments",
	})
}

templ DashboardMonthTrends(c *Ctx, stats DashboardStats) {
	<div>
		<h3 class="sr-only">{ c.l("str.stats") }</h3>
		<dl class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
			<div class="app-card relative">
				<dt>
					<div class="avatar overflow-hidden absolute mt-1 ml-1">
						<div class="h-10">
							<img class="w-full object-contain" src="/public/images/patients.png"/>
						</div>
					</div>
					<p class="ml-16 truncate text-sm font-medium text-base-content">
						{ c.l("str.patients") }
					</p>
				</dt>
				<dd class="ml-16 flex items-baseline">
					<p class="text-2xl font-semibold text-base-content" title={ number.Format(stats.Patients.Total, c.Locale) }>{ number.Compact(stats.Patients.Total, c.Locale) }</p>
					<p class="ml-2 flex items-baseline text-sm font-semibold text-success">
						@CmpArrowUpIcon("h-5 w-5 flex-shrink-0 self-center text-success")
						<span class="sr-only">{ c.l("str.increased_by") }</span>
						{ number.Compact(stats.Patients.Diff, c.Locale) }
					</p>
					<div class="ml-auto">
						<a href="/patients" class="font-medium link link-hover">{ c.l("btn.view_all") }<span class="sr-only">{ c.l("str.patients") }</span></a>
					</div>
				</dd>
			</div>
			<div class="app-card">
				<dt>
					<div class="avatar overflow-hidden absolute mt-1 ml-1">
						<div class="h-10">
							<img class="" src="/public/images/timeline.png"/>
						</div>
					</div>
					<p
						class="ml-16 truncate text-sm font-medium text-base-content"
					>{ c.l("str.appointments") }</p>
				</dt>
				<dd class="ml-16 flex items-baseline">
					<p class="text-2xl font-semibold text-base-content" title={ number.Format(stats.Appointments.Total, c.Locale) }>{ number.Compact(stats.Appointments.Total, c.Locale) }</p>
					<p class="ml-2 flex items-baseline text-sm font-semibold text-success">
						@CmpArrowUpIcon("h-5 w-5 flex-shrink-0 self-center text-success")
						<span class="sr-only">{ c.l("str.increased_by") }</span>
						{ number.Compact(stats.Appointments.Diff, c.Locale) }
					</p>
					<div class="ml-auto">
						<a href="/appointments?timeframe=month" class="font-medium link link-hover">{ c.l("btn.view_all") }<span class="sr-only">{ c.l("str.all_appointments") }</span></a>
					</div>
				</dd>
			</div>
			<div class="app-card">
				<dt>
					<div class="avatar overflow-hidden absolute mt-1 ml-1">
						<div class="h-10">
							<img class="" src="/public/images/funds.png"/>
						</div>
					</div>
					<p class="ml-16 truncate text-sm font-medium text-base-content">{ c.l("str.revenue_month") }</p>
				</dt>
				<dd class="ml-16 flex items-baseline">
					<p class="text-2xl font-semibold text-base-content" title={ amount.Format(stats.Revenue.Total, c.Locale) }>{ amount.FormatCompact(stats.Revenue.Total, c.Locale) }</p>
					if pct, ok := stats.Revenue.Change(); ok {
						if pct >= 0 {
							<p class="ml-2 flex items-baseline text-sm font-semibold text-success">
								@CmpArrowUpIcon("h-5 w-5 flex-shrink-0 self-center text-success")
								<span class="sr-only">{ c.l("str.increased_by") }</span>
								{ dashboardRevenueChange(pct) }
							</p>
						} else {
							<p class="ml-2 flex items-baseline text-sm font-semibold text-error">
								@CmpArrowDownIcon("h-5 w-5 flex-shrink-0 self-center text-error")
								<span class="sr-only">{ c.l("str.decreased_by") }</span>
								{ dashboardRevenueChange(pct) }
							</p>
						}
					}
					<div class="ml-auto">
						<a href="/revenue" class="font-medium link link-hover">{ c.l("btn.view_all") }<span class="sr-only">{ c.l("str.all_revenue") }</span></a>
					</div>
				</dd>
			</div>
		</dl>
	</div>
}

// dashboardRevenueChange formats a percent change without its sign, e.g. 3.2%.
func dashboardRevenueChange(pct float64) string {
	return fmt.Sprintf("%.1f%%", math.Abs(pct))
}

templ DashboardFavoriteClinic(c *Ctx, clinic models.Clinic) {
	if clinic.UID != "" {
		<div class="app-card">
			<div class="relative flex flex-wrap">
				<div class="flex items-center w-full gap-2 justify-between mb-6">
					<h3 class="font-semibold text-xl leading-6 indicator mr-32">
						{ clinic.Name }
						<div class="badge badge-secondary indicator-item -right-4">5</div>
					</h3>
					<div class="avatar shadow-md rounded-full overflow-hidden absolute -right-2 -top-2 border border-base-content/10">
						<div class="w-20">
							<img src={ clinic.ProfilePic }/>
						</div>
					</div>
				</div>
				if clinic.Address.Line1 != "" {
					<div class="mt-4 flex w-full flex-none gap-x-4">
						<dt class="flex-none">
							<span class="sr-only">Address</span>
							@CmpBuildingIcon()
						</dt>
						<dd class="text-sm leading-6">
							{ clinic.Address.Line1 }
						</dd>
					</div>
				}
				if clinic.Phone != "" {
					<div class="mt-4 flex w-full flex-none gap-x-4">
						<dt class="flex-none">
							<span class="sr-only">Phone</span>
							@CmpPhoneIcon()
						</dt>
						<dd class="text-sm leading-6 ">
							{ clinic.Phone }
						</dd>
					</div>
				}
				if clinic.Email != "" {
					<div class="mt-4 flex w-full flex-none gap-x-4">
						<dt class="flex-none">
							<span class="sr-only">Email</span>
							@CmpEmailIcon()
						</dt>
						<dd class="text-sm leading-6 ">
							{ clinic.Email }
						</dd>
					</div>
				}
			</div>
			<div class="flex flex-row items-center mt-6 pt-6">
				<a href="/appointments?timeframe=day" class="link link-hover font-semibold">{ c.l("str.view_appt") }</a>
				<ul class="ml-auto flex gap-2">
					<li>
						<a class="rounded-full bg-base-100" hx-boost="true">
							@CmpFacebookIcon()
						</a>
					</li>
					<li>
						<a class="rounded-full bg-base-100">
							@CmpMessengerIcon()
						</a>
					</li>
					<li>
						<a class="rounded-full bg-base-100">
							@CmpTelegramIcon()
						</a>
					</li>
					<li>
						<a class="rounded-full bg-base-100">
							@CmpWhatsappIcon()
						</a>
					</li>
				</ul>
			</div>
		</div>
	}
}

templ LatestTransactions() {
	<ul role="list" class="mt-8 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-x-4 gap-y-8 lg:gap-x-6">
