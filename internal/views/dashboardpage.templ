				</div>
				<div class="flex justify-between gap-x-4 py-3">
					<dt class="text-base-500">Amount</dt>
					<dd class="flex items-start gap-x-2">
						<div class="font-medium text-base-content">$2,000.00</div>
						<div class="badge badge-success">paid</div>
					</dd>
				</div>
			</dl>
		</li>
	</ul>
}

func feedEventColorClass(action string) string {
	switch action {
	case "created":
		return "text-info"
	case "confirmed", "completed":
		return "text-success"
	case "canceled", "deleted":
		return "text-error"
	case "updated", "changed":
		return "text-warning"
	default:
		return "text-base-content/60"
	}
}

func feedEventSubjectLabel(c *Ctx, event models.FeedEvent) string {
	if event.SubjectType == "appointments" {
		return c.l("str.appointment")
	}

	return event.Subject
}

func feedEventShortDateTime(t time.Time) string {
	if t.IsZero() {
		return ""
	}

	return libtime.InTimezone(t, models.DefaultTimezone).Format("02 Jan, 3:04pm")
}

func feedEventTitle(c *Ctx, event models.FeedEvent) string {
	if event.SubjectType == "appointments" && event.Action == "created" {
		return c.l("str.feed_new_appointment")
	}

	return feedEventSubjectLabel(c, event) + " " + c.l(FeedActionLocaleKey(event.Action))
}

templ feedEventIcon(action string) {
	switch action {
		case "created":
			@CmpPlusCircleIcon("size-5")
		case "updated":
			@CmpPencilIcon("size-5")
		case "confirmed", "completed":
			@CmpCheckCircleIcon("size-5")
		case "canceled":
			@CmpCloseCircleIcon("size-5")
		case "deleted":
			@CmpTrashIcon("size-5")
		default:
			@CmpCalendarIcon("size-5")
	}
}

templ DashboardFeed(c *Ctx, events []models.FeedEvent) {
	<div class="app-card">
		<h3 class="font-semibold text-xl mb-6">My feed</h3>
		if len(events) == 0 {
			<p class="text-sm text-base-content/60 py-4">{ c.l("str.no_recent_activity") }</p>
		} else {
			<ul role="list" class="space-y-6">
				for i, event := range events {
					<li class="relative flex gap-x-4">
						if i < len(events)-1 {
							<div class="absolute left-0 top-0 flex w-8 justify-center -bottom-6">
								<div class="w-px bg-base-content/10"></div>
							</div>
						} else {
							<div class="absolute left-0 top-0 flex w-8 justify-center h-8">
								<div class="w-px bg-base-content/10"></div>
							</div>
						}
						<div class={ "relative flex h-8 w-8 flex-none items-center justify-center rounded-full bg-base-100 " + feedEventColorClass(event.Action) }>
							@feedEventIcon(event.Action)
						</div>
						<div class="flex-auto py-0.5">
							<p class="text-sm font-medium leading-5 text-base-content">
								<a href={ templ.SafeURL(event.SubjectURL) } class="hover:underline">{ feedEventTitle(c, event) }</a>
							</p>
							<p class="text-[11px] text-base-content/50 mt-0.5">
								<a href={ templ.SafeURL(event.TargetURL) } title={ event.Target } class="inline-block max-w-[16ch] truncate align-bottom font-medium text-base-content hover:underline">{ event.Target }</a>
								if feedEventShortDateTime(event.OcurredAt) != "" {
									<span>{ " • " }</span>
									<a href={ templ.SafeURL(event.SubjectURL) } class="badge badge-accent badge-xs hover:opacity-90">{ feedEventShortDateTime(event.OcurredAt) }</a>
								}
							</p>
						</div>
					</li>
				}
			</ul>
		}
	</div>
}
