package views

import (
	"miconsul/internal/lib/preferences"
	"strconv"
	"time"
)

// assetVersion busts browser caches of static assets once per process start.
var assetVersion = strconv.FormatInt(time.Now().Unix(), 36)

templ RootLayout(c *Ctx) {
	<!DOCTYPE html>
	<html
		lang={ c.Locale }
		if c.Theme != "" {
			data-theme={ preferences.ThemeName(preferences.ThemeLight) }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="htmx-config" content='{"includeIndicatorCSS":false}'/>
			@favicons(c)
			<title>Miconsul</title>
			<link href={ "/public/global.css?v=" + assetVersion } rel="stylesheet"/>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0/dist/htmx.min.js" integrity="sha384-BvJpBiO8Kh31EqtJe5DRIeWrHWnCGkwytKs9NKFi86Hhw96dEqdEMzZDeK9iEGTc" crossorigin="anonymous"></script>
		</head>
		<body class="grow">
			{ children... }
			@CmpToastRegion(c)
		</body>
	</html>
}

templ DefaultLayout(c *Ctx) {
	@RootLayout(c) {
		<div id="root" class="bg-base-200">
			@CmpNavbar(c)
			<main id="main" class="grow flex flex-col">
				{ children... }
			</main>
			@CmpFooter(c)
		</div>
	}
}

templ BackBtnLayout(c *Ctx, backpath string) {
	@DefaultLayout(c) {
		<div class="hidden md:block px-4 lg:px-8">
			@CmpBackBtn(c.l("btn.back"), backpath)
		</div>
		{ children... }
	}
}

// ChartsLayout is the signed-in app page for pages with charts: its <head>
// loads ApexCharts, deferred. Each page includes
// public/js/charts.js, deferred, after its charts. Links to these pages must
// not be boosted: htmx drops the <head> of boosted pages.
templ ChartsLayout(c *Ctx) {
	<!DOCTYPE html>
	<html
		lang={ c.Locale }
		if c.Theme != "" {
			data-theme={ preferences.ThemeName(preferences.ThemeLight) }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="htmx-config" content='{"includeIndicatorCSS":false}'/>
			@favicons(c)
			<title>Miconsul</title>
			<link href={ "/public/global.css?v=" + assetVersion } rel="stylesheet"/>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0/dist/htmx.min.js" integrity="sha384-BvJpBiO8Kh31EqtJe5DRIeWrHWnCGkwytKs9NKFi86Hhw96dEqdEMzZDeK9iEGTc" crossorigin="anonymous"></script>
			<link
				rel="stylesheet"
				href="https://cdn.jsdelivr.net/npm/apexcharts@6.10.0/dist/apexcharts.css"
				integrity="sha384-xiwYvoUk6woTSrViYmFRB6voHXkdMsbOIPNggFn88nizTDFhys4ThD1QO/AhVyJA"
				crossorigin="anonymous"
			/>
			<script
				defer
				src="https://cdn.jsdelivr.net/npm/apexcharts@6.10.0/dist/apexcharts.min.js"
				integrity="sha384-5EG9CeSqSzymwY307XCL4zMqifjcpwh/uGHYg1CPiyMNHVvfCcx8VZi2JzW2035O"
				crossorigin="anonymous"
			></script>
		</head>
		<body class="grow">
			<div id="root" class="bg-base-200">
				@CmpNavbar(c)
				<main id="main" class="grow flex flex-col">
					{ children... }
				</main>
				@CmpFooter(c)
			</div>
			@CmpToastRegion(c)
		</body>
	</html>
}

templ AuthLayout(c *Ctx) {
	@RootLayout(c) {
		<div id="root" class="min-h-screen flex flex-col justify-center py-12 sm:px-6 lg:px-8 bg-base-200">
			{ children... }
		</div>
	}
}

templ CenteredLayout(c *Ctx) {
	@RootLayout(c) {
		<div id="root" class="flex flex-col justify-center py-12 sm:px-6 lg:px-8 bg-base-200">
			{ children... }
		</div>
	}
}

templ favicons(c *Ctx) {
	<!-- Standard favicon -->
	<link rel="icon" href="/favicon.ico" sizes="any"/>
	<!-- PNG favicons -->
	<link rel="icon" type="image/png" sizes="16x16" href="/public/favicon-16x16.png"/>
	<link rel="icon" type="image/png" sizes="32x32" href="/public/favicon-32x32.png"/>
	<!-- Apple -->
	<link rel="apple-touch-icon" sizes="180x180" href="/public/apple-touch-icon.png"/>
	<!-- Android / PWA -->
	<link rel="icon" type="image/png" sizes="192x192" href="/public/android-chrome-192x192.png"/>
	<link rel="icon" type="image/png" sizes="512x512" href="/public/android-chrome-512x512.png"/>
	<!-- Web App Manifest -->
	<link rel="manifest" href="/public/site.webmanifest"/>
	<!-- Optional theme color -->
	<meta name="theme-color" content="#5abdfa"/>
}
