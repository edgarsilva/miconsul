package views

import (
	"fmt"

	"miconsul/internal/models"
)

templ CmpSearchInput(c *Ctx, placeholder, path, target string) {
	<label class="input flex items-center gap-2 rounded-full focus:outline">
		@CmpSearchIcon("size-5")
		<input
			name="searchTerm"
			value={ c.Query("searchTerm", "") }
			type="search"
			class="grow"
			placeholder={ placeholder }
			hx-get={ path }
			hx-target={ target }
			hx-swap="outerHTML"
			hx-trigger={ searchInputTrigger() }
		/>
		<kbd class="kbd kbd-sm">ctrl</kbd>
		<kbd class="kbd kbd-sm">k</kbd>
	</label>
}

// searchInputTrigger searches once the term reaches models.MinSearchTermLen
// characters, and again when it is cleared.
func searchInputTrigger() string {
	return fmt.Sprintf(
		"input[this.value.length >= %[1]d] changed delay:500ms, keyup[this.value.length == 0] changed delay:500ms, search[this.value.length >= %[1]d]",
		models.MinSearchTermLen,
	)
}
